<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema normal de la app (ajusta si ya tienes uno) -->
    <style name="Theme.RedThread" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Splash para Android 12+ -->
    <style name="Theme.RedThread.Splash" parent="Theme.SplashScreen">
        <!-- fondo del splash -->
        <item name="windowSplashScreenBackground">@drawable/splash_bg</item>
        <!-- icono encima del fondo (puede ser tu ic_launcher) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- tema que toma la app despues del splash -->
        <item name="postSplashScreenTheme">@style/Theme.RedThread</item>
    </style>

</resources>
